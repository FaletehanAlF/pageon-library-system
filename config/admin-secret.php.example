<?php

declare(strict_types=1);

/**
 * CONTOH config portal admin rahasia — file ini BOLEH di-push.
 *
 * Cara pakai (cukup sekali di laptop owner):
 *   1. Jalankan:  php generate-admin-portal.php
 *   2. Script akan membuat file ASLI:  config/admin-secret.php
 *      + route rahasia: routes/admin-portal.php
 *   3. Kedua file asli itu MASUK .gitignore → tidak ikut ke-push.
 *   4. Simpan URL + kode invite yang dicetak script. Jangan disebar.
 *
 * Format file asli (config/admin-secret.php):
 */
return [
    // Bagian URL setelah /pageon, mis: 'kelola-a1b2c3...' → URL jadi /pageon/kelola-a1b2c3...
    'slug' => 'GANTI-DENGAN-SLUG-RAHASIA-ANDA',
    // Kode undangan untuk mendaftarkan admin ke-2. Wajib diisi saat daftar via portal rahasia.
    'invite_code' => 'GANTI-DENGAN-KODE-RAHASIA',
    // Batas maksimal akun admin (default 2).
    'max_admins' => 2,
];
